<Window x:Class="LocationVoitures.BackOffice.AddLocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="➕ Nouvelle Location" 
        Height="720" 
        Width="850"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="White">

    <Window.Resources>
        <!-- Styles pour les sections -->
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="Background" Value="#ECF0F1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#34495E"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,8,0,5"/>
        </Style>

        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="StandardComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="StandardDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📝 Créer une Nouvelle Location" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#2C3E50"/>
            <TextBlock Text="Remplissez les informations pour créer une location" 
                       FontSize="13" 
                       Foreground="#7F8C8D" 
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Formulaire -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <!-- ======================== SECTION CLIENT ======================== -->
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="🧑 SÉLECTION DU CLIENT" 
                                   Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="Rechercher un client" 
                                   Style="{StaticResource Label}"/>
                        <TextBox x:Name="TxtSearchClient"
                                 Style="{StaticResource SearchTextBox}"
                                 Tag="🔍 Rechercher par nom, prénom, CIN ou téléphone..."
                                 TextChanged="TxtSearchClient_TextChanged"
                                 GotFocus="TxtSearchClient_GotFocus"
                                 LostFocus="TxtSearchClient_LostFocus"/>

                        <TextBlock Text="Client *" 
                                   Style="{StaticResource Label}"/>
                        <ComboBox x:Name="CmbClient" 
                                  Style="{StaticResource StandardComboBox}"
                                  DisplayMemberPath="DisplayText"
                                  SelectedValuePath="Id"
                                  SelectionChanged="CmbClient_SelectionChanged"/>

                        <!-- Informations du client sélectionné -->
                        <Border x:Name="PnlClientInfo" 
                                Background="#D5F4E6" 
                                CornerRadius="5" 
                                Padding="10" 
                                Margin="0,10,0,0"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="TxtClientInfo" 
                                           FontSize="12" 
                                           Foreground="#27AE60"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Button Content="➕ Nouveau Client" 
                                Margin="0,15,0,0" 
                                Height="35"
                                Background="#27AE60" 
                                Foreground="White"
                                FontSize="13"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnNouveauClient_Click"/>
                    </StackPanel>
                </Border>

                <!-- ======================== SECTION VÉHICULE ======================== -->
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="🚗 SÉLECTION DU VÉHICULE" 
                                   Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="Rechercher un véhicule" 
                                   Style="{StaticResource Label}"/>
                        <TextBox x:Name="TxtSearchVoiture"
                                 Style="{StaticResource SearchTextBox}"
                                 Tag="🔍 Rechercher par marque, modèle ou matricule..."
                                 TextChanged="TxtSearchVoiture_TextChanged"
                                 GotFocus="TxtSearchVoiture_GotFocus"
                                 LostFocus="TxtSearchVoiture_LostFocus"/>

                        <TextBlock Text="Véhicule *" 
                                   Style="{StaticResource Label}"/>
                        <ComboBox x:Name="CmbVoiture" 
                                  Style="{StaticResource StandardComboBox}"
                                  DisplayMemberPath="DisplayText"
                                  SelectedValuePath="Id"
                                  SelectionChanged="CmbVoiture_SelectionChanged"/>

                        <!-- Informations du véhicule sélectionné -->
                        <Border x:Name="PnlVoitureInfo" 
                                Background="#D6EAF8" 
                                CornerRadius="5" 
                                Padding="10" 
                                Margin="0,10,0,0"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="TxtVoitureInfo" 
                                           FontSize="12" 
                                           Foreground="#3498DB"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ======================== SECTION DATES ======================== -->
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="📅 PÉRIODE DE LOCATION" 
                                   Style="{StaticResource SectionTitle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Date de début *" 
                                           Style="{StaticResource Label}"/>
                                <DatePicker x:Name="DpDateDebut" 
                                            Style="{StaticResource StandardDatePicker}"
                                            SelectedDateChanged="Dates_Changed"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Date de fin *" 
                                           Style="{StaticResource Label}"/>
                                <DatePicker x:Name="DpDateFin" 
                                            Style="{StaticResource StandardDatePicker}"
                                            SelectedDateChanged="Dates_Changed"/>
                            </StackPanel>
                        </Grid>

                        <!-- Durée calculée -->
                        <Border x:Name="PnlDuree" 
                                Background="#FFF3CD" 
                                CornerRadius="5" 
                                Padding="10" 
                                Margin="0,15,0,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="TxtDuree" 
                                       FontSize="13" 
                                       FontWeight="SemiBold"
                                       Foreground="#F39C12"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ======================== SECTION PRIX ======================== -->
                <Border Background="#D5F4E6" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="💰 CALCUL DU PRIX" 
                                   Style="{StaticResource SectionTitle}"
                                   Foreground="#27AE60"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtPrixDetails" 
                                           FontSize="12" 
                                           Foreground="#34495E"
                                           TextWrapping="Wrap"
                                           LineHeight="20"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="30,0,0,0">
                                <TextBlock Text="Total" 
                                           FontSize="12" 
                                           Foreground="#7F8C8D"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtPrixTotal" 
                                           FontSize="28" 
                                           FontWeight="Bold" 
                                           Foreground="#27AE60"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="🔄 Recalculer le Prix"
                                Margin="0,15,0,0" 
                                Height="35"
                                Background="#F39C12" 
                                Foreground="White"
                                FontSize="13"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnCalculerPrix_Click"/>
                    </StackPanel>
                </Border>

                <!-- ======================== OPTIONS ======================== -->
                <Border Background="#FCF3CF" 
                        CornerRadius="8" 
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="⚙️ OPTIONS" 
                                   Style="{StaticResource SectionTitle}"
                                   Foreground="#F39C12"/>
                        
                        <CheckBox x:Name="ChkEnvoiEmail" 
                                  Content="📧 Envoyer un email de confirmation au client" 
                                  IsChecked="True"
                                  FontSize="13"
                                  Foreground="#34495E"
                                  Margin="0,5,0,10"/>
                        
                        <CheckBox x:Name="ChkGenererPdf" 
                                  Content="📄 Générer automatiquement le contrat PDF" 
                                  IsChecked="True"
                                  FontSize="13"
                                  Foreground="#34495E"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Boutons d'action -->
        <Grid Grid.Row="2" Margin="0,25,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" 
                    Content="❌ Annuler" 
                    Style="{StaticResource ActionButton}"
                    Background="#95A5A6"
                    Click="BtnAnnuler_Click"/>

            <Button Grid.Column="2" 
                    Content="✅ Créer la Location" 
                    Style="{StaticResource ActionButton}"
                    Background="#27AE60"
                    Click="BtnAjouterLocation_Click"/>
        </Grid>
    </Grid>
</Window>