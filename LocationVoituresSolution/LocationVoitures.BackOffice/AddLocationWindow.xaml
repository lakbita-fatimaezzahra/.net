<Window x:Class="LocationVoitures.BackOffice.AddLocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="➕ Nouvelle Location" 
        Height="600" 
        Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Grid.Row="0" 
                   Text="📝 Créer une Nouvelle Location" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="#2C3E50"
                   Margin="0,0,0,20"/>

        <!-- Formulaire -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Client -->
                <Border Background="#ECF0F1" 
                        CornerRadius="8" 
                        Padding="15" 
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="🧑 SÉLECTION DU CLIENT" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   Foreground="#34495E"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Client *" Margin="0,5,0,5"/>
                        <ComboBox x:Name="CmbClient" 
                                  Height="35" 
                                  DisplayMemberPath="FullName"
                                  SelectedValuePath="Id"/>

                        <Button Content="+ Nouveau Client" 
                                Margin="0,10,0,0" 
                                Height="30"
                                Background="#27AE60" 
                                Foreground="White"
                                Click="BtnNouveauClient_Click"/>
                    </StackPanel>
                </Border>

                <!-- Véhicule -->
                <Border Background="#ECF0F1" 
                        CornerRadius="8" 
                        Padding="15" 
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="🚗 SÉLECTION DU VÉHICULE" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   Foreground="#34495E"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Véhicule *" Margin="0,5,0,5"/>
                        <ComboBox x:Name="CmbVoiture" 
                                  Height="35" 
                                  DisplayMemberPath="DisplayText"
                                  SelectedValuePath="Id"
                                  SelectionChanged="CmbVoiture_SelectionChanged"/>

                        <TextBlock x:Name="TxtVoitureInfo" 
                                   Margin="0,10,0,0" 
                                   FontSize="12"
                                   Foreground="#7F8C8D"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Dates -->
                <Border Background="#ECF0F1" 
                        CornerRadius="8" 
                        Padding="15" 
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="📅 PÉRIODE DE LOCATION" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   Foreground="#34495E"
                                   Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Date de début *" Margin="0,5,0,5"/>
                                <DatePicker x:Name="DpDateDebut" 
                                            Height="35"
                                            SelectedDateChanged="Dates_Changed"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Date de fin *" Margin="0,5,0,5"/>
                                <DatePicker x:Name="DpDateFin" 
                                            Height="35"
                                            SelectedDateChanged="Dates_Changed"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="PnlDuree" 
                                    Margin="0,10,0,0" 
                                    Visibility="Collapsed">
                            <TextBlock x:Name="TxtDuree" 
                                       FontSize="12" 
                                       FontWeight="SemiBold"
                                       Foreground="#3498DB"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Prix -->
                <Border Background="#D5F4E6" 
                        CornerRadius="8" 
                        Padding="15" 
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="💰 CALCUL DU PRIX" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   Foreground="#27AE60"
                                   Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock x:Name="TxtPrixDetails" 
                                           FontSize="12" 
                                           Foreground="#34495E"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" 
                                       x:Name="TxtPrixTotal" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       Foreground="#27AE60"
                                       VerticalAlignment="Center"
                                       Margin="20,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Options -->
                <Border Background="#FCF3CF" 
                        CornerRadius="8" 
                        Padding="15">
                    <StackPanel>
                        <CheckBox x:Name="ChkEnvoiEmail" 
                                  Content="📧 Envoyer un email de confirmation au client" 
                                  IsChecked="True"
                                  FontSize="12"
                                  Margin="0,5,0,5"/>
                        <CheckBox x:Name="ChkGenererPdf" 
                                  Content="📄 Générer automatiquement le contrat PDF" 
                                  IsChecked="True"
                                  FontSize="12"
                                  Margin="0,5,0,5"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Boutons -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" 
                    Content="❌ Annuler" 
                    Height="45" 
                    Margin="0,0,10,0"
                    Background="#95A5A6" 
                    Foreground="White" 
                    FontSize="14"
                    Click="BtnAnnuler_Click"/>

            <Button Grid.Column="1" 
                    Content="✅ Créer la Location" 
                    Height="45" 
                    Margin="10,0,0,0"
                    Background="#27AE60" 
                    Foreground="White" 
                    FontSize="14" 
                    FontWeight="SemiBold"
                    Click="BtnCreer_Click"/>
        </Grid>
    </Grid>
</Window>