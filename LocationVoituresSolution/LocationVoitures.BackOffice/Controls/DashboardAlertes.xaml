<UserControl x:Class="LocationVoitures.BackOffice.Controls.DashboardAlertes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" CornerRadius="10" Padding="20" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="🔔 Alertes de Maintenance" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Background="#DC143C" Padding="10" Margin="0,0,10,0" CornerRadius="5" Width="100">
                    <StackPanel>
                        <TextBlock Text="Critiques" Foreground="White" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtCritique" Text="0" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="#FF4500" Padding="10" Margin="0,0,10,0" CornerRadius="5" Width="100">
                    <StackPanel>
                        <TextBlock Text="Urgentes" Foreground="White" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtUrgent" Text="0" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Button Content="Voir toutes les alertes →" 
                    Click="VoirAlertes_Click"
                    Background="#3498DB"
                    Foreground="White"
                    Padding="10"
                    Cursor="Hand"
                    HorizontalAlignment="Stretch"/>
        </StackPanel>
    </Border>
</UserControl>