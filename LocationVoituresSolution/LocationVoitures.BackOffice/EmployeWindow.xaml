<Window x:Class="LocationVoitures.BackOffice.EmployeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LocationVoitures.BackOffice"
        mc:Ignorable="d"
        Title="EmployeWindow"
        Height="450"
        Width="1950"
        WindowState="Maximized"
        ResizeMode="CanResize">

    <Window.Resources>

        <!-- Styles sidebar -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF34495E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="230"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="SidebarSubButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Padding" Value="30,0"/>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Width" Value="230"/>
            <Setter Property="Background" Value="#FF34495E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <StackPanel Grid.Column="0" Background="#FF2C3E50" HorizontalAlignment="Left" Width="187">
            <!-- Profil -->
            <StackPanel Orientation="Vertical" Margin="20" VerticalAlignment="Top">
                <!-- Avatar avec icône -->
                <Grid Width="80" Height="80" Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonDown="EllipseProfil_MouseLeftButtonDown">
                    <Ellipse x:Name="EllipseProfil" 
                      Width="80" 
                      Height="80" 
                      Fill="#3498DB"
                      Stroke="#2980B9"
                      StrokeThickness="2">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.8"/>
                                        <Setter Property="Fill" Value="#2980B9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                        <Ellipse.ToolTip>
                            <ToolTip Content="Cliquez pour voir votre profil"/>
                        </Ellipse.ToolTip>
                    </Ellipse>
                    <!-- Icône utilisateur au centre -->
                    <TextBlock Text="👤" 
                        FontSize="40" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"/>
                </Grid>
                <TextBlock x:Name="TxtUserName" 
                    Text="Utilisateur" 
                    Foreground="White" 
                    FontWeight="Bold" 
                    FontSize="16" 
                    Margin="0,10,0,0" 
                    TextAlignment="Center"
                    Cursor="Hand"
                    MouseLeftButtonDown="TxtUserName_MouseLeftButtonDown"/>
                <TextBlock x:Name="TxtUserEmail" 
                    Text="email@example.com" 
                    Foreground="White" 
                    FontSize="12" 
                    TextAlignment="Center" 
                    TextWrapping="Wrap"
                    Cursor="Hand"
                    MouseLeftButtonDown="TxtUserEmail_MouseLeftButtonDown"/>
            </StackPanel>

            <Separator Margin="10,10"/>

            <!-- Menu -->
            <StackPanel>
                <Button Style="{StaticResource SidebarButtonStyle}" Click="DashboardButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Tableaux de bord"/>
                    </StackPanel>
                </Button>
              

                <!-- Gestion des clients -->
                <Button Style="{StaticResource SidebarButtonStyle}"  Click="ClientsButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👥" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Gestion des clients"/>
                    </StackPanel>
                </Button>



                <!-- Gestion des véhicules -->
                <Expander x:Name="VehiclesExpander" Header="Gestion des voitures" Expanded="Expander_Expanded">
                    <StackPanel>
                        <Button Style="{StaticResource SidebarSubButtonStyle}" Click="VehiclesButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚗" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="voiture et images"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarSubButtonStyle}" Click="Type_voitureButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💰" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Type voiture"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Expander>

                <!-- Gestion des locations -->
                <Button Style="{StaticResource SidebarButtonStyle}" Click="LocationButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Locations"/>
                    </StackPanel>
                </Button>


                <Button Style="{StaticResource SidebarButtonStyle}" Click="AlertesButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔔" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Alertes d'entretien"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SidebarButtonStyle}" Click="MaintenancesButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛠️" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Maintenances"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </StackPanel>

        <!-- Contenu principal -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Ligne pour logout -->
                <RowDefinition Height="*"/>
                <!-- Contenu -->
            </Grid.RowDefinitions>

            <!-- Bouton Logout -->
            <Button Width="35" Height="35" HorizontalAlignment="Right" Margin="0,10,10,0" Click="LogoutButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#E74C3C"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Padding" Value="5,2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C0392B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#A93226"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <!-- Icône Logout -->
                        <Path Data="M17,7L15.59,8.41L18.17,11H8V13H18.17L15.59,15.58L17,17L22,12M4,5H12V3H4C2.89,3 2,3.89 2,5V19C2,20.1 2.89,21 4,21H12V19H4V5Z" 
                  Fill="White" 
                  Stretch="Uniform" 
                  Width="16" 
                  Height="16"
                  Margin="0,0,5,0"/>
                        <TextBlock VerticalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
            </Button>

            <!-- Frame pour navigation -->
            <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Margin="-60,5,10,-5"/>

        </Grid>

    </Grid>

</Window>
