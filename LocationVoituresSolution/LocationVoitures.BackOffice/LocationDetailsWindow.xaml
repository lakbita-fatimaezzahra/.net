<Window x:Class="LocationVoitures.BackOffice.LocationDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="👁️ Détails de la Location" 
        Height="650" 
        Width="800"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <Grid>
                <TextBlock x:Name="TxtTitle" 
                           Text="👁️ Détails de la Location" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="#2C3E50"/>

                <Border x:Name="BrdStatut" 
                        HorizontalAlignment="Right" 
                        CornerRadius="15" 
                        Padding="15,8">
                    <TextBlock x:Name="TxtStatut" 
                               FontSize="14" 
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </StackPanel>

        <!-- Contenu -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Info Principale -->
                <Border Background="#ECF0F1" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="📋 INFORMATIONS GÉNÉRALES" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="#34495E"
                                       Margin="0,0,0,15"/>

                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="N° Location:" Width="120" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="TxtLocationId" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="Date début:" Width="120" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="TxtDateDebut"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="Date fin:" Width="120" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="TxtDateFin"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="Durée:" Width="120" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="TxtDuree" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="💰 INFORMATIONS FINANCIÈRES" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="#34495E"
                                       Margin="0,0,0,15"/>

                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="Prix total:" Width="120" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="TxtPrixTotal" FontWeight="Bold" Foreground="#27AE60"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="Montant payé:" Width="120" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="TxtMontantPaye" FontWeight="SemiBold" Foreground="#3498DB"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="Reste à payer:" Width="120" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="TxtResteAPayer" FontWeight="Bold" Foreground="#E74C3C"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Client -->
                <Border Background="#E8F8F5" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="🧑 INFORMATIONS CLIENT" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   Foreground="#27AE60"
                                   Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nom complet:" Foreground="#7F8C8D" Margin="0,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtClientNom" FontWeight="SemiBold" Margin="0,5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="CIN:" Foreground="#7F8C8D" Margin="0,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtClientCIN" Margin="0,5"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Téléphone:" Foreground="#7F8C8D" Margin="0,5"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtClientTel" Margin="0,5"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Email:" Foreground="#7F8C8D" Margin="0,5"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtClientEmail" Margin="0,5"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Adresse:" Foreground="#7F8C8D" Margin="0,5"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtClientAdresse" TextWrapping="Wrap" Margin="0,5"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Véhicule -->
                <Border Background="#D6EAF8" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="🚗 INFORMATIONS VÉHICULE" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   Foreground="#3498DB"
                                   Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Véhicule:" Foreground="#7F8C8D" Margin="0,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtVehicule" FontWeight="SemiBold" Margin="0,5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Matricule:" Foreground="#7F8C8D" Margin="0,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtMatricule" FontWeight="Bold" Margin="0,5"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Type:" Foreground="#7F8C8D" Margin="0,5"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtType" Margin="0,5"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Kilométrage:" Foreground="#7F8C8D" Margin="0,5"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtKilometrage" Margin="0,5"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Prix/jour:" Foreground="#7F8C8D" Margin="0,5"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtPrixJour" FontWeight="SemiBold" Foreground="#27AE60" Margin="0,5"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Paiements -->
                <Border x:Name="BrdPaiements" 
                        Background="#FEF9E7" 
                        CornerRadius="8" 
                        Padding="20"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="💳 HISTORIQUE DES PAIEMENTS" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   Foreground="#F39C12"
                                   Margin="0,0,0,15"/>

                        <DataGrid x:Name="DgPaiements" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  Height="150"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  RowHeight="35"
                                  FontSize="11">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" 
                                                    Binding="{Binding DatePaiement, StringFormat=dd/MM/yyyy HH:mm}" 
                                                    Width="130"/>
                                <DataGridTextColumn Header="Montant" 
                                                    Binding="{Binding Montant, StringFormat='{}{0:F2} MAD'}" 
                                                    Width="100"/>
                                <DataGridTextColumn Header="Mode" 
                                                    Binding="{Binding ModePaiement}" 
                                                    Width="*"/>
                                <DataGridTextColumn Header="Statut" 
                                                    Binding="{Binding Statut}" 
                                                    Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Boutons -->
        <UniformGrid Grid.Row="2" 
                     Rows="1" 
                     Columns="3" 
                     Margin="0,20,0,0">
            <Button Content="💳 Paiements" 
                    Height="45" 
                    Margin="0,0,5,0"
                    Background="#27AE60" 
                    Foreground="White" 
                    FontSize="13"
                    Click="BtnPaiements_Click"/>

            <Button Content="📄 Générer PDF" 
                    Height="45" 
                    Margin="5,0"
                    Background="#9B59B6" 
                    Foreground="White" 
                    FontSize="13"
                    Click="BtnGeneratePdf_Click"/>

            <Button Content="✖️ Fermer" 
                    Height="45" 
                    Margin="5,0,0,0"
                    Background="#95A5A6" 
                    Foreground="White" 
                    FontSize="13"
                    Click="BtnFermer_Click"/>
        </UniformGrid>
    </Grid>
</Window>