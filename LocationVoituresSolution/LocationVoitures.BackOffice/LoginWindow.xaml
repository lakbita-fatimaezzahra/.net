<Window x:Class="LocationVoitures.BackOffice.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion" Height="500" Width="423" WindowStartupLocation="CenterScreen"
        Background="#FF2C3E50" ResizeMode="NoResize">

    <Grid Height="439" VerticalAlignment="Top">
        <!-- Conteneur principal blanc avec coins arrondis -->
        <Border CornerRadius="15" Background="White" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center" Width="293" Height="321">
            <StackPanel>

                <!-- Titre -->
                <TextBlock Text="Connexion" FontSize="28" FontWeight="Bold" Foreground="#FF2C3E50" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Email -->
                <TextBlock Text="Email" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Name="txtEmail" Height="30" FontSize="14" Padding="5" />

                <!-- Mot de passe -->
                <TextBlock Text="Mot de passe" FontWeight="Bold" Margin="10,15,0,5"/>
                <PasswordBox Name="txtPassword" Height="30" FontSize="14" Padding="5"/>

                <!-- Bouton login stylé -->
                <Button Height="35" Margin="0,20,0,0" Background="#FF2C3E50" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnLogin_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="10" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="Se connecter"/>
                </Button>

                <!-- Message d'erreur -->
                <TextBlock Name="lblError" Foreground="Red" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
