<Window x:Class="LocationVoitures.BackOffice.MarquerMaintenanceEffectueeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Marquer Maintenance Effectuée" 
        Height="600" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

<Grid Margin="20">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- En-tête -->
    <Border Grid.Row="0" Background="#2196F3" Padding="15" CornerRadius="5" Margin="0,0,0,20">
        <TextBlock Text="✓ Maintenance Effectuée" 
                       FontSize="20" FontWeight="Bold" 
                       Foreground="White" 
                       HorizontalAlignment="Center"/>
    </Border>

    <!-- Formulaire -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Informations véhicule -->
            <GroupBox Header="Véhicule" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Véhicule:" FontWeight="Bold" Margin="0,5,0,5"/>
                    <TextBox x:Name="txtVoiture" IsReadOnly="True" Background="#F0F0F0"/>
                </StackPanel>
            </GroupBox>

            <!-- Informations maintenance -->
            <GroupBox Header="Maintenance" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Type:" FontWeight="Bold" Margin="0,5"/>
                    <TextBox x:Name="txtTypeMaintenance" Grid.Row="1" Grid.Column="0" 
                                 IsReadOnly="True" Background="#F0F0F0" Margin="0,0,5,10"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Date prévue:" FontWeight="Bold" Margin="0,5"/>
                    <TextBox x:Name="txtDatePrevue" Grid.Row="1" Grid.Column="1" 
                                 IsReadOnly="True" Background="#F0F0F0" Margin="5,0,0,10"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Garage:" FontWeight="Bold" Margin="0,5"/>
                    <TextBox x:Name="txtGarage" Grid.Row="3" Grid.Column="0" 
                                 IsReadOnly="True" Background="#F0F0F0" Margin="0,0,5,10"/>

                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Coût estimé:" FontWeight="Bold" Margin="0,5"/>
                    <TextBox x:Name="txtCoutEstime" Grid.Row="3" Grid.Column="1" 
                                 IsReadOnly="True" Background="#F0F0F0" Margin="5,0,0,10"/>
                </Grid>
            </GroupBox>

            <!-- Saisie des informations d'exécution -->
            <GroupBox Header="Exécution" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Date d'exécution: *" FontWeight="Bold" Margin="0,5"/>
                    <DatePicker x:Name="dpDateExecution" Margin="0,0,0,10"/>

                    <TextBlock Text="Coût réel (MAD): *" FontWeight="Bold" Margin="0,5"/>
                    <TextBox x:Name="txtCoutReel" 
                                 PreviewTextInput="txtCoutReel_PreviewTextInput"
                                 Margin="0,0,0,10"/>

                    <TextBlock Text="Notes du garage:" FontWeight="Bold" Margin="0,5"/>
                    <TextBox x:Name="txtNotesGarage" 
                                 Height="100" 
                                 TextWrapping="Wrap" 
                                 AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>

    <!-- Boutons -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button x:Name="BtnEnregistrer" Content="✓ Enregistrer" 
                    Width="120" Height="35" Margin="0,0,10,0"
                    Background="#4CAF50" Foreground="White"
                    FontWeight="Bold" FontSize="14"
                    Click="BtnEnregistrer_Click"
                    Cursor="Hand"/>

        <Button x:Name="BtnAnnuler" Content="✕ Annuler" 
                    Width="100" Height="35"
                    Background="#F44336" Foreground="White"
                    FontWeight="Bold" FontSize="14"
                    Click="BtnAnnuler_Click"
                    Cursor="Hand"/>
    </StackPanel>
</Grid>
</Window>
