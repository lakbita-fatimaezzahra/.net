<Page x:Class="LocationVoitures.BackOffice.Pages.AlertesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:LocationVoitures.BackOffice.Pages"
      Title="Alertes de Maintenance">
    
    <Page.Resources>
        <!-- Converter pour masquer le bouton Résoudre si l'alerte est résolue -->
        <local:StatutAlerteToVisibilityConverter x:Key="StatutToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Text="🔔 Alertes de Maintenance" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <!-- Statistiques par urgence -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <Border Background="#DC143C" Padding="15" Margin="0,0,10,0" CornerRadius="5" Cursor="Hand">
                <StackPanel>
                    <TextBlock Text="🔴 CRITIQUE" Foreground="White" FontWeight="Bold" FontSize="12"/>
                    <TextBlock x:Name="txtCritique" Text="0" Foreground="White" FontSize="24" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="#FF4500" Padding="15" Margin="0,0,10,0" CornerRadius="5" Cursor="Hand">
                <StackPanel>
                    <TextBlock Text="🔴 URGENT" Foreground="White" FontWeight="Bold" FontSize="12"/>
                    <TextBlock x:Name="txtUrgent" Text="0" Foreground="White" FontSize="24" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="#FF8C00" Padding="15" Margin="0,0,10,0" CornerRadius="5" Cursor="Hand">
                <StackPanel>
                    <TextBlock Text="🟠 ATTENTION" Foreground="White" FontWeight="Bold" FontSize="12"/>
                    <TextBlock x:Name="txtAttention" Text="0" Foreground="White" FontSize="24" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="#FFD700" Padding="15" Margin="0,0,10,0" CornerRadius="5" Cursor="Hand">
                <StackPanel>
                    <TextBlock Text="🟡 À PRÉVOIR" Foreground="Black" FontWeight="Bold" FontSize="12"/>
                    <TextBlock x:Name="txtAPrevoir" Text="0" Foreground="Black" FontSize="24" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="#27AE60" Padding="15" Margin="0,0,10,0" CornerRadius="5" Cursor="Hand">
                <StackPanel>
                    <TextBlock Text="✓ Résolues" Foreground="White" FontWeight="Bold" FontSize="12"/>
                    <TextBlock x:Name="txtResolues" Text="0" Foreground="White" FontSize="24" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Barre d'actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
            <ComboBox x:Name="cmbFiltre" 
                      Width="200" 
                      SelectionChanged="Filtre_SelectionChanged"
                      Margin="0,0,10,0">
                <ComboBoxItem Content="Toutes les alertes" IsSelected="True"/>
                <ComboBoxItem Content="🔴 Critiques"/>
                <ComboBoxItem Content="🔴 Urgentes"/>
                <ComboBoxItem Content="🟠 Attention"/>
                <ComboBoxItem Content="🟡 À prévoir"/>
                <ComboBoxItem Content="✓ Résolues"/>
            </ComboBox>

            <Button Content="🗑️ Supprimer résolues" 
                    Click="SupprimerResolues_Click"
                    Background="#E74C3C" 
                    Foreground="White"
                    Padding="10"
                    Cursor="Hand"/>
        </StackPanel>

        <!-- DataGrid des alertes -->
        <DataGrid x:Name="dgAlertes" 
                  Grid.Row="3"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  RowBackground="White"
                  AlternatingRowBackground="#F5F5F5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>

                <DataGridTextColumn Header="Voiture" Width="180">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="{}{0} {1} ({2})">
                            <Binding Path="Voiture.Marque"/>
                            <Binding Path="Voiture.Modele"/>
                            <Binding Path="Voiture.Matricule"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>

                <DataGridTextColumn Header="Statut" Binding="{Binding Statut}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Statut}" Value="Active">
                                    <Setter Property="Foreground" Value="Red"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Statut}" Value="Résolue">
                                    <Setter Property="Foreground" Value="Green"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Actions" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="✓ Résoudre" 
                                        Click="Resoudre_Click"
                                        Tag="{Binding Id}"
                                        Background="#27AE60"
                                        Foreground="White"
                                        Margin="0,0,5,0"
                                        Padding="8,3"
                                        FontSize="11"
                                        Cursor="Hand"
                                        Visibility="{Binding Statut, Converter={StaticResource StatutToVisibilityConverter}}"/>
                                <Button Content="📋 Détails" 
                                        Click="Details_Click"
                                        Tag="{Binding VoitureId}"
                                        Background="#3498DB"
                                        Foreground="White"
                                        Margin="0,0,5,0"
                                        Padding="8,3"
                                        FontSize="11"
                                        Cursor="Hand"/>
                                <Button Content="🗑️" 
                                        Click="Supprimer_Click"
                                        Tag="{Binding Id}"
                                        Background="#E74C3C"
                                        Foreground="White"
                                        Padding="8,3"
                                        FontSize="11"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>