<Page x:Class="LocationVoitures.BackOffice.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      xmlns:controls="clr-namespace:LocationVoitures.BackOffice.Controls"
      Title="Dashboard">

    <Page.Resources>
        <!-- Style pour les cartes -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2" Color="Gray"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="📊 Tableau de Bord" FontSize="28" FontWeight="Bold"/>
                <TextBlock x:Name="TxtDateHeure" Text="Dernière mise à jour : --" 
                           FontSize="14" Foreground="Gray" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Bannière d'alertes critiques -->
            <Border x:Name="AlertesBanner" 
                    Grid.Row="1" 
                    Background="#DC143C" 
                    CornerRadius="10" 
                    Padding="15" 
                    Margin="0,0,0,20"
                    Visibility="Collapsed"
                    Cursor="Hand"
                    MouseLeftButtonDown="AlertesBanner_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️" FontSize="24" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock x:Name="txtAlerteBanner" 
                                   Text="Alertes de maintenance détectées" 
                                   Foreground="White" 
                                   FontWeight="Bold" 
                                   FontSize="16"/>
                        <TextBlock Text="Cliquez pour voir les détails" 
                                   Foreground="White" 
                                   FontSize="12" 
                                   Opacity="0.9"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Statistiques principales -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Utilisateurs -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Background="#9B59B6">
                    <StackPanel>
                        <TextBlock Text="👤 Utilisateurs" Style="{StaticResource CardTitleStyle}" Foreground="White"/>
                        <TextBlock x:Name="TxtUsersCount" Text="{Binding UsersCount}" Style="{StaticResource ValueStyle}" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- Total Voitures -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Background="#3498DB">
                    <StackPanel>
                        <TextBlock Text="🚗 Voitures" Style="{StaticResource CardTitleStyle}" Foreground="White"/>
                        <TextBlock x:Name="TxtCarsCount" Text="{Binding CarsCount}" Style="{StaticResource ValueStyle}" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- Total Locations -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Background="#27AE60">
                    <StackPanel>
                        <TextBlock Text="📋 Locations" Style="{StaticResource CardTitleStyle}" Foreground="White"/>
                        <TextBlock x:Name="TxtRentalsCount" Text="{Binding RentalsCount}" Style="{StaticResource ValueStyle}" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- Total Clients -->
                <Border Grid.Column="3" Style="{StaticResource CardStyle}" Background="#E67E22">
                    <StackPanel>
                        <TextBlock Text="👥 Clients" Style="{StaticResource CardTitleStyle}" Foreground="White"/>
                        <TextBlock x:Name="TxtClientsCount" Text="{Binding ClientsCount}" Style="{StaticResource ValueStyle}" Foreground="White"/>
                    </StackPanel>
                </Border>
            </Grid>

           

            <!-- Graphiques -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Locations par mois -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="📈 Locations par Mois" Style="{StaticResource CardTitleStyle}"/>
                        <lvc:CartesianChart Series="{Binding MonthlyRentalsSeries}" 
                                           Height="300" 
                                           LegendLocation="Bottom"
                                           AnimationsSpeed="0:0:0.5"
                                           Hoverable="True"
                                           DataTooltip="{x:Null}">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Title="Mois" 
                                         Labels="{Binding Months}"
                                         FontSize="12"
                                         Separator="{x:Static lvc:DefaultAxes.CleanSeparator}"/>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="Nombre de locations" 
                                         MinValue="0"
                                         FontSize="12"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </StackPanel>
                </Border>

                <!-- Répartition par type de voiture -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="🚙 Types de Véhicules" Style="{StaticResource CardTitleStyle}"/>
                        <lvc:PieChart Series="{Binding VehicleTypeSeries}" 
                                     Height="300" 
                                     LegendLocation="Bottom"
                                     InnerRadius="40"
                                     AnimationsSpeed="0:0:0.5"
                                     Hoverable="True"
                                     DataTooltip="{x:Null}">
                            <lvc:PieChart.ChartLegend>
                                <lvc:DefaultLegend BulletSize="15"/>
                            </lvc:PieChart.ChartLegend>
                        </lvc:PieChart>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>