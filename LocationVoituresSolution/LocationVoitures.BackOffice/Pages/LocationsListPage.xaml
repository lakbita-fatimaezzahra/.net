<Page x:Class="LocationVoitures.BackOffice.LocationListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:LocationVoitures.BackOffice"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Background="White">

    <Page.Resources>
        <local:StatutToVisibilityConverter x:Key="StatutToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="🚗 Gestion des Locations" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#2C3E50"
                       VerticalAlignment="Center"/>
            <Button Content="➕ Nouvelle Location" 
                    Width="180" 
                    Height="40" 
                    Margin="20,0,0,0"
                    Background="#27AE60" 
                    Foreground="White" 
                    FontSize="14" 
                    FontWeight="SemiBold"
                    BorderThickness="0" 
                    Cursor="Hand"
                    Click="BtnNouvelleLocation_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="5" 
                                            Padding="10">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#229954"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- Barre de recherche et filtres -->
        <Border Grid.Row="1" 
                Background="#ECF0F1" 
                CornerRadius="8" 
                Padding="15" 
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <!-- Recherche -->
                <TextBox x:Name="TxtSearch" 
                         Grid.Column="0"
                         Height="35" 
                         Padding="10" 
                         FontSize="13"
                         Margin="0,0,10,0"
                         VerticalContentAlignment="Center"
                         TextChanged="TxtSearch_TextChanged">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderBrush" Value="#BDC3C7"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="🔍 Rechercher..." 
                                                               Foreground="#95A5A6" 
                                                               Margin="5,0,0,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Filtre Statut -->
                <ComboBox x:Name="CmbStatut" 
                          Grid.Column="1"
                          Height="35"
                          Margin="0,0,10,0"
                          FontSize="13"
                          SelectionChanged="CmbStatut_SelectionChanged">
                    <ComboBoxItem Content="Tous les statuts" IsSelected="True"/>
                    <ComboBoxItem Content="En cours"/>
                    <ComboBoxItem Content="Terminée"/>
                    <ComboBoxItem Content="Annulée"/>
                </ComboBox>

                <!-- Bouton Import -->
                <Button Grid.Column="2" 
                        Content="📥 Importer" 
                        Height="35"
                        Margin="0,0,10,0"
                        Background="#E67E22" 
                        Foreground="White" 
                        BorderThickness="0"
                        Click="BtnImport_Click"/>

                <!-- Bouton Export -->
                <Button Grid.Column="3" 
                        Content="📊 Exporter" 
                        Height="35"
                        Background="#9B59B6" 
                        Foreground="White" 
                        BorderThickness="0"
                        Click="BtnExport_Click"/>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" 
                BorderBrush="#BDC3C7" 
                BorderThickness="1" 
                CornerRadius="5">
            <DataGrid x:Name="DgLocations" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      CanUserAddRows="False" 
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowHeight="50"
                      FontSize="13"
                      Background="White"
                      AlternatingRowBackground="#F8F9FA">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N° Location" 
                                        Binding="{Binding Id}" 
                                        Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#2C3E50"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Client" Width="100">
                        <DataGridTextColumn.Binding>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <Binding Path="Client.Nom"/>
                                <Binding Path="Client.Prenom"/>
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Véhicule" Width="100">
                        <DataGridTextColumn.Binding>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <Binding Path="Voiture.Marque"/>
                                <Binding Path="Voiture.Modele"/>
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Matricule" 
                                        Binding="{Binding Voiture.Matricule}" 
                                        Width="100"/>

                    <DataGridTextColumn Header="Début" 
                                        Binding="{Binding DateDebut, StringFormat=dd/MM/yyyy}" 
                                        Width="100"/>

                    <DataGridTextColumn Header="Fin" 
                                        Binding="{Binding DateFin, StringFormat=dd/MM/yyyy}" 
                                        Width="100"/>

                    <DataGridTextColumn Header="Prix Total" 
                                        Binding="{Binding PrixTotal, StringFormat='{}{0:F2} MAD'}" 
                                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#27AE60"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Statut" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" 
                                        Padding="8,4" 
                                        HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Statut}" Value="En cours">
                                                    <Setter Property="Background" Value="#D5F4E6"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Statut}" Value="Terminée">
                                                    <Setter Property="Background" Value="#D6EAF8"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Statut}" Value="Annulée">
                                                    <Setter Property="Background" Value="#FADBD8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Statut}" 
                                               FontWeight="SemiBold" 
                                               FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Statut}" Value="En cours">
                                                        <Setter Property="Foreground" Value="#27AE60"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Statut}" Value="Terminée">
                                                        <Setter Property="Foreground" Value="#3498DB"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Statut}" Value="Annulée">
                                                        <Setter Property="Foreground" Value="#E74C3C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Actions" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="👁️" Width="35" Height="35" Margin="5,0"
                                            Background="#3498DB" Foreground="White"
                                            ToolTip="Détails" Click="BtnDetails_Click"
                                            Tag="{Binding}"/>
                                    <Button Content="💳" Width="35" Height="35" Margin="5,0"
                                            Background="#27AE60" Foreground="White"
                                            ToolTip="Paiements" Click="BtnPaiements_Click"
                                            Tag="{Binding}"/>
                                    <Button Content="📄" Width="35" Height="35" Margin="5,0"
                                            Background="#9B59B6" Foreground="White"
                                            ToolTip="Générer PDF" Click="BtnGeneratePdf_Click"
                                            Tag="{Binding}"/>
                                    <Button Content="✅" Width="35" Height="35" Margin="5,0"
                                            Background="#F39C12" Foreground="White"
                                            ToolTip="Terminer" Click="BtnTerminer_Click"
                                            Tag="{Binding}"
                                            Visibility="{Binding Statut, Converter={StaticResource StatutToVisibilityConverter}}"/>
                                    <Button Content="❌" Width="35" Height="35" Margin="5,0"
                                            Background="#E74C3C" Foreground="White"
                                            ToolTip="Annuler" Click="BtnAnnuler_Click"
                                            Tag="{Binding}"
                                            Visibility="{Binding Statut, Converter={StaticResource StatutToVisibilityConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Pagination -->
        <Border Grid.Row="3" 
                Background="#ECF0F1" 
                CornerRadius="5" 
                Padding="10" 
                Margin="0,10,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="Total: " FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTotalItems" 
                               Text="0" 
                               FontWeight="Bold" 
                               Foreground="#2C3E50" 
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" locations" Margin="5,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="◀️ Précédent" x:Name="BtnPrevious" Width="120" Height="30" Margin="5,0" Click="BtnPrevious_Click"/>
                    <TextBlock x:Name="TxtPageInfo" Text="Page 1 / 1" Margin="15,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="Suivant ▶️" x:Name="BtnNext" Width="120" Height="30" Margin="5,0" Click="BtnNext_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Éléments par page:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="CmbPageSize" Width="80" Height="30" SelectionChanged="CmbPageSize_SelectionChanged">
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="25" IsSelected="True"/>
                        <ComboBoxItem Content="50"/>
                        <ComboBoxItem Content="100"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>