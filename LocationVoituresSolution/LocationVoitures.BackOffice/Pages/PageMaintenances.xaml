<Page x:Class="LocationVoitures.BackOffice.Pages.PageMaintenances"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1000"
      Background="White"
      Title="PageMaintenances">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="🛠️ Gestion des Maintenances" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#2C3E50"
                       VerticalAlignment="Center"/>

           
            
        </StackPanel> 

        <!-- BARRE DE RECHERCHE + FILTRES -->
        <Border Grid.Row="1" Background="#ECF0F1" CornerRadius="8"
                Padding="15" Margin="0,0,0,20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <!-- RECHERCHE -->
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBox x:Name="SearchBox"
                             Width="300" Height="35"
                             Padding="10" FontSize="13"
                             Margin="0,0,10,0"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged">

                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="BorderBrush" Value="#BDC3C7"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="🔍 Rechercher maintenance..."
                                                                   Foreground="#95A5A6"
                                                                   Margin="5,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>

                    </TextBox>

                    <!-- RADIO FILTRE -->
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                        <RadioButton x:Name="rbType" Content="Type" IsChecked="True" Margin="5,0"/>
                        <RadioButton x:Name="rbGarage" Content="Garage" Margin="5,0"/>
                        <RadioButton x:Name="rbStatut" Content="Statut" Margin="5,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- BOUTON IMPORT -->
                <Button Grid.Column="1" Content="📥 Importer" Height="35"
                        Background="#E67E22" Foreground="White" Margin="0,0,10,0"
                        BorderThickness="0" Cursor="Hand"/>

                <!-- BOUTON EXPORT -->
                <Button Grid.Column="2" Content="📊 Exporter" Height="35"
                        Background="#9B59B6" Foreground="White"
                        BorderThickness="0" Cursor="Hand"/>
            </Grid>

        </Border>

        <!-- DATAGRID -->
        <Border Grid.Row="2" BorderBrush="#BDC3C7" BorderThickness="1"
                CornerRadius="5">

            <DataGrid x:Name="dgMaintenances"
                      AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False"
                      AlternatingRowBackground="#F8F9FA"
                      HorizontalGridLinesBrush="#ECF0F1"
                      RowHeight="50" Background="White">

                <!-- HEADER STYLE -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2C3E50"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Height" Value="45"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- LIGNES -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EAF3FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <!-- COLONNES -->
                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding Id}"
                                        Width="60"/>

                    <DataGridTextColumn Header="Voiture"
                                        Binding="{Binding Voiture.Matricule}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding TypeMaintenance}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Date"
                                        Binding="{Binding DateMaintenance, StringFormat=dd/MM/yyyy}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Km"
                                        Binding="{Binding KilometrageMaintenance}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Garage"
                                        Binding="{Binding Garage}"
                                        Width="70"/>
                    
                    <DataGridTextColumn Header="Cout"
                    Binding="{Binding CoutReel}"
                    Width="50"/>
                    
                    <DataGridTextColumn Header="Statut"
                                        Binding="{Binding Statut}"
                                        Width="90"/>

                    <!-- ACTIONS -->
                    <DataGridTemplateColumn Header="Actions" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                    <!-- Modifier -->
                                    <!-- Bouton Modifier -->
                                    <Button Content="✏️" 
                                ToolTip="Modifier"
                                Tag="{Binding}"
                                Click="BtnEdit_Click"
                                Width="30" Height="30"
                                Background="#2196F3"
                                Foreground="White"
                                Margin="2"
                                Cursor="Hand"/>

                                    <!-- ✅ NOUVEAU BOUTON : Marquer effectuée -->
                                    <Button Content="✓" 
                                ToolTip="Marquer comme effectuée"
                                Tag="{Binding}"
                                Click="BtnMarquerEffectuee_Click"
                                Width="30" Height="30"
                                Background="#4CAF50"
                                Foreground="White"
                                Margin="2"
                                Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <!-- Afficher uniquement si Planifiée ou En cours -->
                                                    <DataTrigger Binding="{Binding Statut}" Value="Planifiée">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Statut}" Value="En cours">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Statut}" Value="En retard">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Supprimer -->
                                    <Button Content="🗑️" Width="35" Height="35" Margin="5"
                                            Background="#E74C3C" Foreground="White"
                                            BorderThickness="0"
                                            Click="BtnDelete_Click"
                                            Tag="{Binding}"/>

                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>
        </Border>

        <!-- FOOTER / PAGINATION -->
        <Border Grid.Row="3" Background="#ECF0F1" CornerRadius="5"
                Padding="10" Margin="0,10,0,0">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <Button x:Name="BtnPrev" Content="◀️ Précédent"
                        Width="120" Height="30" Margin="5"
                        Background="#3498DB" Foreground="White"
                        Click="BtnPrev_Click"/>

                <TextBlock x:Name="TxtPageInfo"
                           Text="Page 1 / 1"
                           Margin="15,0"
                           FontSize="14" FontWeight="SemiBold"/>

                <Button x:Name="BtnNext" Content="Suivant ▶️"
                        Width="120" Height="30" Margin="5"
                        Background="#3498DB" Foreground="White"
                        Click="BtnNext_Click"/>
            </StackPanel>

        </Border>

    </Grid>
</Page>
