<Page x:Class="LocationVoitures.BackOffice.Pages.TypeVoiturePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      
      Title="TypeVoiturePage"
      Background="#F5F6FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="🏷️ Gestion des Types de Véhicules" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#2C3E50"
                       VerticalAlignment="Center"/>
            <Button Content="➕ Nouveau Type" 
                    Width="180" 
                    Height="40" 
                    Margin="20,0,0,0"
                    Background="#27AE60" 
                    Foreground="White" 
                    FontSize="14" 
                    FontWeight="SemiBold"
                    BorderThickness="0" 
                    Cursor="Hand"
                    Click="AddButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="5" 
                                            Padding="10">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#229954"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- Barre d'actions -->
        <Border Grid.Row="1" 
                Background="#ECF0F1" 
                CornerRadius="8" 
                Padding="15" 
                Margin="0,0,0,20">
            <Grid>
                <TextBlock Text="Gérez les catégories de véhicules" 
                           FontSize="13" 
                           Foreground="#7F8C8D" 
                           VerticalAlignment="Center"/>

               
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" 
                BorderBrush="#BDC3C7" 
                BorderThickness="1" 
                CornerRadius="5">
            <DataGrid x:Name="TypeVoitureDataGrid" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      CanUserAddRows="False" 
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowHeight="50"
                      FontSize="13"
                      Background="White"
                      AlternatingRowBackground="#F8F9FA">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" 
                                        Binding="{Binding Id}" 
                                        Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#2C3E50"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Nom du Type" 
                                        Binding="{Binding Nom}" 
                                        Width="200">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Description" 
                                        Binding="{Binding Description}" 
                                        Width="*"/>

                    <DataGridTemplateColumn Header="Actions" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="✏️" Width="35" Height="35" Margin="5,0"
                                            Background="#3498DB" Foreground="White"
                                            ToolTip="Modifier" Click="EditButton_Click"
                                            Tag="{Binding}"/>
                                    <Button Content="🗑️" Width="35" Height="35" Margin="5,0"
                                            Background="#E74C3C" Foreground="White"
                                            ToolTip="Supprimer" Click="DeleteButton_Click"
                                            Tag="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Info et actions rapides -->
        <Border Grid.Row="3" 
                Background="#ECF0F1" 
                CornerRadius="5" 
                Padding="10" 
                Margin="0,10,0,0">
            <Grid>
              

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Total: " FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTotalItems" 
                               Text="0" 
                               FontWeight="Bold" 
                               Foreground="#2C3E50" 
                               VerticalAlignment="Center" 
                               Margin="5,0"/>
                    <TextBlock Text=" types" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>