<Page x:Class="LocationVoitures.BackOffice.Pages.VoitureDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LocationVoitures.BackOffice.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="VoitureDetailsPage">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Détails de la Voiture"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- PARTIE GAUCHE : Image principale + Carousel -->
                <StackPanel Grid.Column="0">

                    <!-- Image principale -->
                    <Border BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,15" Height="250">
                        <Image x:Name="ImagePrincipale" Stretch="Uniform"/>
                    </Border>

                    <!-- Carousel -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto">
                        <StackPanel x:Name="CarouselImages"
                                    Orientation="Horizontal"
                                    Margin="0,10,0,0"/>
                    </ScrollViewer>

                </StackPanel>

                <!-- PARTIE DROITE : Infos + QR Code -->
                <StackPanel Grid.Column="1" Margin="20,0,0,0">

                    <TextBlock Text="Informations" FontSize="20" FontWeight="Bold"/>

                    <StackPanel Margin="0,10,0,0">

                        <TextBlock Text="{Binding Matricule}" FontSize="16"/>
                        <TextBlock Text="{Binding Marque}" FontSize="16"/>
                        <TextBlock Text="{Binding Modele}" FontSize="16"/>
                        <TextBlock Text="Kilométrage :" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Kilometrage}" />

                        <TextBlock Text="Dernière maintenance :" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding DerniereMaintenance}" />
                    </StackPanel>

                    <TextBlock Text="QR Code" FontSize="20" FontWeight="Bold" Margin="0,20,0,5"/>

                    <Border BorderBrush="Black" BorderThickness="1" Padding="10">
                        <Image x:Name="QRCodeImage" Width="160" Height="160"/>
                    </Border>

                  

                    <Button Content="Retour"
                            Width="120"
                            Margin="0,10,0,0"
                            Click="Retour_Click"/>

                </StackPanel>

            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
