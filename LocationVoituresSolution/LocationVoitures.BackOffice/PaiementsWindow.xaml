
      <Window x:Class="LocationVoitures.BackOffice.PaiementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="💳 Gestion des Paiements" 
        Height="600" 
        Width="700"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="💳 Gestion des Paiements" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="#2C3E50"
                           Margin="0,0,0,8"/>
                <TextBlock x:Name="TxtLocationInfo" 
                           FontSize="12" 
                           Foreground="#7F8C8D"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Résumé -->
            <Grid Grid.Row="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Prix Total -->
                <Border Grid.Column="0" Background="#E8F8F5" CornerRadius="6" Padding="10" Margin="0,0,5,0">
                    <StackPanel>
                        <TextBlock Text="💰 Prix Total" FontSize="11" Foreground="#7F8C8D"/>
                        <TextBlock x:Name="TxtPrixTotal" FontSize="20" FontWeight="Bold" Foreground="#27AE60" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Montant Payé -->
                <Border Grid.Column="1" Background="#D6EAF8" CornerRadius="6" Padding="10" Margin="5,0">
                    <StackPanel>
                        <TextBlock Text="✅ Montant Payé" FontSize="11" Foreground="#7F8C8D"/>
                        <TextBlock x:Name="TxtMontantPaye" FontSize="20" FontWeight="Bold" Foreground="#3498DB" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Reste à Payer -->
                <Border Grid.Column="2" Background="#FADBD8" CornerRadius="6" Padding="10" Margin="5,0,0,0">
                    <StackPanel>
                        <TextBlock Text="⚠️ Reste à Payer" FontSize="11" Foreground="#7F8C8D"/>
                        <TextBlock x:Name="TxtResteAPayer" FontSize="20" FontWeight="Bold" Foreground="#E74C3C" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Contenu principal -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <!-- Liste paiements -->
                <Border Grid.Column="0" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="📋 Historique des Paiements" FontSize="13" FontWeight="SemiBold"
                                   Background="#ECF0F1" Padding="8"/>

                        <DataGrid Grid.Row="1" x:Name="DgPaiements" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  RowHeight="35" FontSize="11" Background="White">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="N°" Binding="{Binding Id}" Width="40"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding DatePaiement, StringFormat=dd/MM/yyyy HH:mm}" Width="120"/>
                                <DataGridTextColumn Header="Montant" Binding="{Binding Montant, StringFormat='{}{0:F2} MAD'}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#27AE60"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Mode" Binding="{Binding ModePaiement}" Width="*"/>
                                <DataGridTemplateColumn Header="Actions" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="📄" Width="25" Height="25" Margin="2" Background="#9B59B6" Foreground="White" ToolTip="Générer reçu" Click="BtnGenerateReceipt_Click" Tag="{Binding}"/>
                                                <Button Content="❌" Width="25" Height="25" Margin="2" Background="#E74C3C" Foreground="White" ToolTip="Annuler" Click="BtnAnnuler_Click" Tag="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Formulaire paiement -->
                <Border Grid.Column="1" Background="#ECF0F1" CornerRadius="6" Padding="10" MinWidth="250">
                    <StackPanel>
                        <TextBlock Text="➕ Nouveau Paiement" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,10"/>
                        <TextBlock Text="Montant (MAD) *" Margin="0,5,0,5"/>
                        <TextBox x:Name="TxtMontant" Height="30" FontSize="13" PreviewTextInput="TxtMontant_PreviewTextInput"/>

                        <UniformGrid Columns="2" Rows="2" Margin="0,8,0,0">
                            <Button Content="50%" Height="30" Margin="2" Click="BtnMontantRapide_Click" Tag="0.5"/>
                            <Button Content="Reste" Height="30" Margin="2" Click="BtnMontantRapide_Click" Tag="1"/>
                            <Button Content="100 MAD" Height="30" Margin="2" Click="BtnMontantRapide_Click" Tag="100"/>
                            <Button Content="500 MAD" Height="30" Margin="2" Click="BtnMontantRapide_Click" Tag="500"/>
                        </UniformGrid>

                        <TextBlock Text="Mode de paiement *" Margin="0,10,0,5"/>
                        <ComboBox x:Name="CmbModePaiement" Height="30">
                            <ComboBoxItem Content="💵 Espèces" IsSelected="True"/>
                            <ComboBoxItem Content="💳 Carte bancaire"/>
                            <ComboBoxItem Content="🏦 Virement"/>
                            <ComboBoxItem Content="📱 Mobile Money"/>
                            <ComboBoxItem Content="✅ Chèque"/>
                        </ComboBox>

                        <TextBlock Text="Notes (optionnel)" Margin="0,10,0,5"/>
                        <TextBox x:Name="TxtNotes" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                        <Button Content="✅ Enregistrer le Paiement" Height="40" Margin="0,15,0,0" Background="#27AE60" Foreground="White" FontSize="13" FontWeight="SemiBold" Click="BtnEnregistrer_Click"/>
                        <Button Content="📄 Générer Facture Complète" Height="35" Margin="0,8,0,0" Background="#3498DB" Foreground="White" FontSize="11" Click="BtnGenerateFacture_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Fermer -->
            <Button Grid.Row="3" Content="✖️ Fermer" Height="35" Margin="0,15,0,0" Background="#95A5A6" Foreground="White" FontSize="13" Click="BtnFermer_Click"/>
        </Grid>
    </ScrollViewer>
</Window>

