<Window x:Class="LocationVoitures.BackOffice.PlanifierMaintenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Planifier une maintenance"
        Height="480" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid>
        <StackPanel Margin="20">

        <TextBlock Text="Planifier une maintenance" FontSize="20" FontWeight="Bold" />

        <Label Content="Type de maintenance :" />
        <ComboBox x:Name="cmbType" Width="250">
            <ComboBoxItem Content="Vidange"/>
            <ComboBoxItem Content="Révision"/>
            <ComboBoxItem Content="Contrôle technique"/>
            <ComboBoxItem Content="Diagnostic"/>
        </ComboBox>

        <Label Content="Date :" />
        <DatePicker x:Name="dpDateMaintenance" Width="200"/>

        <Label Content="Kilométrage actuel :" />
        <TextBox x:Name="txtKmMaintenance" Width="200"/>

        <Label Content="Garage :" />
        <TextBox x:Name="txtGarage" Width="250" />

        <Label Content="Description :" />
        <TextBox x:Name="txtDescription" Width="250" Height="70" TextWrapping="Wrap"/>

        <Button Content="Enregistrer" 
            Click="BtnSave_Click" 
            Background="#27AE60" 
            Foreground="White"
            Margin="0,15,0,0"/>
    </StackPanel>

    </Grid>
</Window>
