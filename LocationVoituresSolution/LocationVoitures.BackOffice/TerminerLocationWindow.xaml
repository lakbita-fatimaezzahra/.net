<Window x:Class="LocationVoitures.BackOffice.TerminerLocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="✅ Terminer une Location" 
        Height="650" 
        Width="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="✅ Terminer une Location" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="#2C3E50"
                       Margin="0,0,0,10"/>
            <TextBlock x:Name="TxtLocationInfo" 
                       FontSize="13" 
                       Foreground="#7F8C8D"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Contenu -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Informations Location -->
                <Border Background="#ECF0F1" 
                        CornerRadius="8" 
                        Padding="15" 
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="📋 INFORMATIONS DE LA LOCATION" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   Foreground="#34495E"
                                   Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Client :" Margin="0,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtClient" FontWeight="SemiBold" Margin="0,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Véhicule :" Margin="0,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtVehicule" FontWeight="SemiBold" Margin="0,5"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Période :" Margin="0,5"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtPeriode" Margin="0,5"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Prix initial :" Margin="0,5"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtPrixInitial" FontWeight="SemiBold" Foreground="#27AE60" Margin="0,5"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Km initial :" Margin="0,5"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtKmInitial" Margin="0,5"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Kilométrage Final -->
                <Border Background="#E8F8F5" 
                        CornerRadius="8" 
                        Padding="15" 
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="🛣️ KILOMÉTRAGE FINAL" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   Foreground="#27AE60"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Kilométrage final (km) *" Margin="0,5,0,5"/>
                        <TextBox x:Name="TxtKmFinal" 
                                 Height="40" 
                                 FontSize="14"
                                 TextChanged="TxtKmFinal_TextChanged"
                                 PreviewTextInput="TxtKmFinal_PreviewTextInput"/>
                        <TextBlock x:Name="TxtKmParcouru" 
                                   Margin="0,10,0,0" 
                                   FontSize="12"
                                   Foreground="#7F8C8D"/>
                    </StackPanel>
                </Border>

                <!-- Calcul des Frais -->
                <Border Background="#FEF9E7" 
                        CornerRadius="8" 
                        Padding="15" 
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="💰 CALCUL DES FRAIS" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   Foreground="#F39C12"
                                   Margin="0,0,0,10"/>
                        <StackPanel x:Name="PnlFrais">
                            <!-- Dépassement kilométrique -->
                            <Border x:Name="BrdDepassementKm" 
                                    Background="#FADBD8" 
                                    CornerRadius="5" 
                                    Padding="10" 
                                    Margin="0,0,0,10"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="⚠️ Dépassement kilométrique" 
                                               FontWeight="SemiBold" 
                                               Foreground="#E74C3C"/>
                                    <TextBlock x:Name="TxtDepassementKm" 
                                               FontSize="12" 
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Retard -->
                            <Border x:Name="BrdRetard" 
                                    Background="#FADBD8" 
                                    CornerRadius="5" 
                                    Padding="10" 
                                    Margin="0,0,0,10"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="⚠️ Retard de restitution" 
                                               FontWeight="SemiBold" 
                                               Foreground="#E74C3C"/>
                                    <TextBlock x:Name="TxtRetard" 
                                               FontSize="12" 
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- État du véhicule -->
                            <TextBlock Text="État du véhicule" Margin="0,10,0,5"/>
                            <ComboBox x:Name="CmbEtatVehicule" 
                                      Height="35"
                                      SelectionChanged="CmbEtatVehicule_SelectionChanged">
                                <ComboBoxItem Content="Bon état" IsSelected="True"/>
                                <ComboBoxItem Content="Dommages mineurs"/>
                                <ComboBoxItem Content="Dommages importants"/>
                            </ComboBox>

                            <!-- Frais de dommages -->
                            <StackPanel x:Name="PnlDommages" 
                                        Visibility="Collapsed" 
                                        Margin="0,10,0,0">
                                <TextBlock Text="Frais de réparation (MAD)" Margin="0,5,0,5"/>
                                <TextBox x:Name="TxtFraisDommages" 
                                         Height="35" 
                                         Text="0"
                                         TextChanged="TxtFraisDommages_TextChanged"
                                         PreviewTextInput="TxtKmFinal_PreviewTextInput"/>
                            </StackPanel>

                            <!-- Autres frais -->
                            <TextBlock Text="Autres frais (MAD)" Margin="0,10,0,5"/>
                            <TextBox x:Name="TxtAutresFrais" 
                                     Height="35" 
                                     Text="0"
                                     TextChanged="TxtAutresFrais_TextChanged"
                                     PreviewTextInput="TxtKmFinal_PreviewTextInput"/>

                            <TextBox x:Name="TxtNotesAutresFrais" 
                                     Margin="0,5,0,0"
                                     Height="60"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Top">
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="Notes sur les autres frais..." 
                                                                           Foreground="#95A5A6" 
                                                                           Margin="5,5,0,0"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Total -->
                <Border Background="#D5F4E6" 
                        CornerRadius="8" 
                        Padding="15">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Prix initial :" FontSize="12" Margin="0,2"/>
                            <TextBlock x:Name="TxtRecapPrixInitial" 
                                       FontSize="12" 
                                       FontWeight="SemiBold" 
                                       Margin="0,2"/>
                            <TextBlock Text="+ Frais supplémentaires :" 
                                       FontSize="12" 
                                       Margin="0,10,0,2"/>
                            <TextBlock x:Name="TxtRecapFrais" 
                                       FontSize="12" 
                                       FontWeight="SemiBold" 
                                       Foreground="#E74C3C" 
                                       Margin="0,2"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="TOTAL À PAYER" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="#27AE60"/>
                            <TextBlock x:Name="TxtPrixFinal" 
                                       FontSize="28" 
                                       FontWeight="Bold" 
                                       Foreground="#27AE60"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Boutons -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" 
                    Content="❌ Annuler" 
                    Height="45" 
                    Margin="0,0,10,0"
                    Background="#95A5A6" 
                    Foreground="White" 
                    FontSize="14"
                    Click="BtnAnnuler_Click"/>

            <Button Grid.Column="1" 
                    Content="✅ Terminer la Location" 
                    Height="45" 
                    Margin="10,0,0,0"
                    Background="#27AE60" 
                    Foreground="White" 
                    FontSize="14" 
                    FontWeight="SemiBold"
                    Click="BtnTerminer_Click"/>
        </Grid>
    </Grid>
</Window>
