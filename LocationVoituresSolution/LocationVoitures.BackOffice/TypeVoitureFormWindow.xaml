<Window x:Class="LocationVoitures.BackOffice.TypeVoitureFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LocationVoitures.BackOffice"
        mc:Ignorable="d"
        Title="TypeVoitureFormWindow" Height="492" Width="800">
   
        <Window.Resources>
            <Style x:Key="InputStyle" TargetType="TextBox">
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="BorderBrush" Value="#BDC3C7"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="LabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#2C3E50"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style x:Key="ButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="45"/>
                <Setter Property="Width" Value="130"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Window.Resources>

        <Border Margin="30">
            <Border Background="White" 
                CornerRadius="12" 
                Padding="30">
                <Border.Effect>
                    <DropShadowEffect Color="#E1E8ED" 
                                  BlurRadius="15" 
                                  ShadowDepth="3" 
                                  Opacity="0.3"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Titre -->
                    <TextBlock Grid.Row="0" 
                           Text="Informations du Type de Voiture" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="#2C3E50"
                           Margin="0,0,0,25"/>

                    <!-- Nom -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <TextBlock Text="Nom du Type *" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="NomTextBox" 
                             Style="{StaticResource InputStyle}"
                             ToolTip="Ex: SUV, Berline, Sportive..."/>
                    </StackPanel>

                    <!-- Description -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,20">
                        <TextBlock Text="Description *" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="DescriptionTextBox" 
                             Height="43"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Padding="10"
                             FontSize="14"
                             BorderBrush="#BDC3C7"
                             BorderThickness="1"
                             ToolTip="Décrivez les caractéristiques du type de voiture"/>
                    </StackPanel>

                    <!-- Boutons -->
                    <StackPanel Grid.Row="4" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">
                        <Button Content="Annuler" 
                            Style="{StaticResource ButtonStyle}"
                            Background="#95A5A6"
                            Margin="0,0,15,0"
                            Click="CancelButton_Click"/>
                        <Button Content="Enregistrer" 
                            Style="{StaticResource ButtonStyle}"
                            Background="#27AE60"
                            Click="SaveButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
   
</Window>
